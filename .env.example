# Kata sandi halaman /admin (CMS lama, dipakai sampai dashboard baru selesai)
CMS_PASSWORD=change-me

# Token Vercel Blob (backend default undangan yang sekarang live)
BLOB_READ_WRITE_TOKEN=

# --- AI Planner ---
# Provider: google (default), openai, groq, openrouter, ollama, gateway
AI_PROVIDER=google
AI_MODEL=gemini-3.6-flash
# Cadangan saat model utama 503 (dipisah koma)
AI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.8-flash

# Gemini free tier: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Provider alternatif
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
APP_URL=http://localhost:3000

# --- Neon (diisi otomatis oleh `neon deploy` / `neon env pull`) ---
# Pooled untuk runtime, unpooled untuk migrasi.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Wajib 32+ karakter: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (S3-compatible, private bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_STORAGE_BUCKET=assets

# Neon Functions
NEON_FUNCTION_HELLO_BASE_URL=

# json = Vercel Blob / filesystem lama, neon = Object Storage
STORAGE_BACKEND=neon

# --- Neon AI Gateway ---
# Belum aktif: gateway tidak melayani request di plan Free.
# Setelah upgrade: aktifkan `aiGateway` di neon.ts, deploy, lalu isi:
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
