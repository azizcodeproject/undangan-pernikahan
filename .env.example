# Kata sandi halaman /admin
# Isi juga di Vercel → Project yusufsintia → Environment Variables.
# Ganti sebelum deploy produksi.
CMS_PASSWORD=change-me

# Token Vercel Blob untuk RSVP, buku tamu, galeri, dan CMS.
# Lokal: boleh dikosongkan — data tetap ditulis ke data/*.json
# Produksi Vercel: wajib. Buat Blob store, hubungkan ke project ini, lalu redeploy.
BLOB_READ_WRITE_TOKEN=
